<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="auditlog.ir_cron_auditlog_autovacuum" model="ir.cron">
            <field name="active" eval="True" />
            <field name="code">model.autovacuum(365*5)</field>
        </record>
    </data>
    <data>
        <record id="ir_cron_auditlog_fiscalevent_autovacuum" model="ir.cron">
            <field name="name">Auto-vacuum audit log fiscal events</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True" />
            <field name="doall" eval="False" />
            <field name="code">model.autovacuum(365*5)</field>
            <field name="state">code</field>
            <field name="model_id" ref="model_auditlog_fiscalevent" />
        </record>
    </data>
</odoo>