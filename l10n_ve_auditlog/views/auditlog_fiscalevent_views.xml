<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View auditlog.fiscalevent View Tree -->
    <record id="view_auditlog_fiscalevent_tree" model="ir.ui.view">
        <field name="name">view.auditlog.fiscalevent.tree</field>
        <field name="model">auditlog.fiscalevent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="res_name" />
                <field name="summary" />
                <field name="tag_ids" widget="many2many_tags" />
                <field name="user_id" />
                <field name="http_session_id" />
                <field name="http_request_id" optional="hide" />
            </tree>
        </field>
    </record>
    <!-- View auditlog.fiscalevent form -->
    <record id="view_auditlog_fiscalevent_form" model="ir.ui.view">
        <field name="name">view.auditlog.fiscalevent.form</field>
        <field name="model">auditlog.fiscalevent</field>
        <field name="arch" type="xml">
            <form string="Evento Fiscal" create="0" edit="0" delete="0">
                <field name="record_still_exists" invisible="1" />
                <field name="has_record" invisible="1" />

                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <field name="message" widget="textarea" class="mt-2 mb-2" style="font-size: 2rem" />

                    <group string="Información adicional del registro">
                        <group>
                            <field name="user_id" options="{'no_create': true, 'no_open': true}" />
                            <!-- <field name="model_id" options="{'no_create': true, 'no_open': true}" /> -->
                            <field name="res_name" placeholder="no hay un registro asociado" />
                            <!-- <field name="http_session_id" /> -->
                            <!-- <field name="http_request_id" /> -->
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" readonly="1" groups="!base.group_no_one" />
                            <field name="tag_ids" widget="many2many_tags" readonly="0" groups="base.group_no_one" />
                            <!-- <field name="current_res_name" /> -->

                            <div class="o_form_label"></div>
                            <button name="action_record_view" string="Ver registro" type="object" class="oe_highlight" invisible="not has_record or not record_still_exists" />
                        </group>
                    </group>

                    <group string="Información técnica">
                        <group>
                            <field name="model_id" options="{'no_create': true, 'no_open': true}" />
                            <field name="http_session_id" />
                            <field name="http_request_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- View auditlog.fiscalevent search -->
    <record id="view_auditlog_fiscalevent_search" model="ir.ui.view">
        <field name="name">view.auditlog.fiscalevent.search</field>
        <field name="model">auditlog.fiscalevent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="user_id" />
            </search>
        </field>
    </record>
    <!-- Action auditlog.fiscalevent -->
    <record id="action_auditlog_fiscalevent" model="ir.actions.act_window">
        <field name="name">Eventos Fiscales</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">auditlog.fiscalevent</field>
        <field name="view_mode">tree,form</field>
        <!-- <field name="domain">[]</field>
        <field name="context">{}</field> -->
        <!-- <field name="help" type="html">
            <p class="oe_view_nocontent_create">There is no examples click here to add new Auditlog Fiscalevent.</p>
        </field> -->
    </record>
</odoo>