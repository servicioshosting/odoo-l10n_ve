<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View auditlog.http.session form -->
    <record id="view_auditlog_http_session_form" model="ir.ui.view">
        <field name="name">view.auditlog.http.session.form.inherit</field>
        <field name="model">auditlog.http.session</field>
        <field name="inherit_id" ref="auditlog.view_auditlog_http_session_form" />
        <field name="arch" type="xml">
            <field position="attributes" name="user_id">
                <attribute name="readonly">1</attribute>
            </field>
            <field position="attributes" name="name">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//form/sheet/group[2]" position="replace">
                <group string="HTTP Requests">
                    <field name="http_request_ids" string="" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
