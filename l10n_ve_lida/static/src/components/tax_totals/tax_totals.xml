<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- Odoo 18 TaxGroupComponent: force readonly tax amounts + show base (Total G). -->
    <t
        t-name="l10n_ve_lida.TaxGroupComponent"
        t-inherit="account.TaxGroupComponent"
        t-inherit-mode="extension"
        owl="1">
        <!-- Replace whole tax amount cell: no pencil/edit (SENIAT amounts must stay system-computed). -->
        <xpath expr="//td[@class='o_tax_group']" position="replace">
            <td class="o_tax_group">
                <span class="o_tax_group_amount_value o_list_monetary" dir="ltr">
                    <t t-out="formatMonetary(props.taxGroup.tax_amount_currency)" style="white-space: nowrap;"/>
                </span>
            </td>
        </xpath>

        <!-- Base amount row before each tax group amount -->
        <xpath expr="//tr" position="before">
            <tr t-if="props.taxGroup.display_base_amount_currency !== false">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label"
                           t-esc="'Total G ' + props.taxGroup.group_name"/>
                </td>
                <td class="o_tax_group">
                    <span class="o_tax_group_amount_value o_list_monetary" dir="ltr">
                        <t t-out="formatMonetary(props.taxGroup.display_base_amount_currency)"
                           style="white-space: nowrap;"/>
                    </span>
                </td>
            </tr>
        </xpath>
    </t>

    <!--
      Note (D1): Odoo 18 TaxTotalsField already renders subtotal.base_amount_currency
      per subtotal. Legacy discount_amount / show_discount / formatted_subtotal keys
      from 17 tax-totals JSON are gone — no discount rows here until Python reintroduces them.
    -->
</templates>
