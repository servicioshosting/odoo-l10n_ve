<odoo>
	<data>
		<record id="view_partner_form_inherited" model="ir.ui.view">
			<field name="name">res.partner.product.form.inherit</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_partner_form" />
			<field name="arch" type="xml">

				<xpath expr="//sheet/group/group/div/field[@name='municipality']" position="replace">
					<field
						name="municipality"
						class="o_address_street"
						placeholder="Municipality"
						required="1"
					/>
				</xpath>
				<field name="city_id" position="attributes">
					<attribute name="required">0</attribute>
					<attribute name="invisible">1</attribute>
				</field>
				<xpath expr="//sheet/group/group/div/field[@name='parish_id']" position="attributes">
					<attribute name="required">0</attribute>
					<attribute name="invisible">1</attribute>
				</xpath>

				<xpath
					expr="//sheet/notebook/page[@name='contact_addresses']/field[@name='child_ids']/form//field[@name='city_id']"
					position="attributes">
					<attribute name="required">0</attribute>
					<attribute name="invisible">1</attribute>
				</xpath>
				<xpath
					expr="//sheet/notebook/page[@name='contact_addresses']/field[@name='child_ids']/form//field[@name='parish_id']"
					position="attributes">
					<attribute name="required">0</attribute>
					<attribute name="invisible">1</attribute>
				</xpath>
			</field>
		</record>
	</data>
</odoo>