<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Audit Rules -->
    <record id="account_retention_auditlog_rule" model="auditlog.rule">
        <field name="name">Auditar las retenciones</field>
        <field name="model_id" ref="l10n_ve_payment_extension.model_account_retention" />
        <field name="state">draft</field>
        <field name="log_read">0</field>
        <field name="log_write">1</field>
        <field name="log_unlink">1</field>
        <field name="log_create">1</field>
        <field name="log_type">full</field>
        <field name="capture_record">1</field>
        <!-- <field name="fields_to_exclude_ids"></field> -->
    </record>

    <!-- Aseguramos que sean adecuadamente activadas -->
    <function model="auditlog.rule" name="unsubscribe">
        <value eval="[ref('account_retention_auditlog_rule')]" />
    </function>
    <function model="auditlog.rule" name="subscribe">
        <value model="auditlog.rule" eval="[ref('account_retention_auditlog_rule')]" />
    </function>
</odoo>