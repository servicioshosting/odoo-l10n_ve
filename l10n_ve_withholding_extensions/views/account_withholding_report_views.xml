<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_withholding_report_form" model="ir.ui.view">
            <field name="name">view.account.withholding.report_form</field>
            <field name="model">account.withholding.report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <header>
                            <button name="action_download_xlsx" type="object" string="Descargar Excel"
                                invisible="not id" />
                            <button name="action_download_seniat" type="object" string="Descargar XML" invisible="not id or tax_type != 'islr'" />
                            <button name="action_download_seniat" type="object" string="Descargar TXT" invisible="not id or tax_type != 'iva'" />
                        </header>

                        <div class="oe_title">
                            <!-- <div class="oe_edit_only">
                                <label for="name" />
                            </div> -->
                            <h1 class="mb32">
                                <field name="name" class="mb16" />
                            </h1>
                        </div>

                        <group>
                            <group name="core">
                                <group name="company">
                                    <field name="company_id" readonly="1" />
                                    <field name="company_currency_id" groups="base.group_no_one" readonly="1" />
                                    <field name="tax_type" readonly="1" />
                                </group>
                                <group name="period">
                                    <field name="year" widget="integer" options='{"format": false}' />
                                    <field name="month" />
                                    <field name="quincena" />
                                </group>
                            </group>
                            <group>
                                <!-- <field name="state" readonly="1" /> -->
                                <field name="period" readonly="1" />
                                <field name="date_start" readonly="1" />
                                <field name="date_end" readonly="1" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Retenciones">
                                <field name="withholdings_ids" readonly="1" />
                            </page>

                            <page string="Detallado">
                                <field name="line_ids" readonly="1" invisible="tax_type != 'islr'">
                                    <tree create="0" edit="0">
                                        <!-- <field name="report_id" /> -->
                                        <!-- <field name="withholding_id" /> -->
                                        <!-- <field name="withholding_line_id" /> -->
                                        <!-- <field name="company_currency_id" /> -->
                                        <!-- <field name="document_type" /> -->
                                        <field name="tax_type" column_invisible="True" />
                                        <field name="withholding_date" />
                                        <field name="withholding_number" />
                                        <field name="document_id" options="{'no_create': true, 'no_open': false}" />
                                        <field name="partner_id" options="{'no_create': true, 'no_open': false}" />
                                        <field name="partner_vat" />
                                        <field name="document_number" optional="show" />
                                        <field name="document_control_number" optional="show" />
                                        <field name="doc_number" groups="base.group_no_one" optional="hide" />
                                        <field name="doc_control_number" groups="base.group_no_one" optional="hide" />
                                        <!-- ISLR -->
                                        <field name="document_amount_untaxed" />
                                        <field name="concept_code" class="text-right" />
                                        <field name="withholding_amount_subtract" />
                                        <!-- ISLR -->
                                        <field name="withholding_percentage" />
                                        <field name="withholding_amount" sum="Total Retenido" />
                                    </tree>
                                </field>

                                <field name="line_ids" readonly="1" invisible="tax_type != 'iva'">
                                    <tree create="0" edit="0">
                                        <!-- <field name="report_id" /> -->
                                        <!-- <field name="withholding_id" /> -->
                                        <!-- <field name="withholding_line_id" /> -->
                                        <!-- <field name="company_currency_id" /> -->
                                        <!-- <field name="document_type" /> -->
                                        <field name="tax_type" column_invisible="True" />
                                        <field name="withholding_date" />
                                        <field name="withholding_number" />
                                        <field name="document_id" options="{'no_create': true, 'no_open': false}" />
                                        <field name="partner_id" options="{'no_create': true, 'no_open': false}" />
                                        <field name="partner_vat" />
                                        <field name="document_number" optional="show" />
                                        <field name="document_control_number" optional="show" />
                                        <field name="doc_number" groups="base.group_no_one" optional="hide" />
                                        <field name="doc_control_number" groups="base.group_no_one" optional="hide" />
                                        <!-- IVA -->
                                        <field name="document_amount_total"  />
                                        <field name="withholding_aliquot_f" string="Alícuota" widget="percentage"  />
                                        <field name="document_tax_amount"  />
                                        <!-- IVA -->
                                        <field name="withholding_percentage" />
                                        <field name="withholding_amount" sum="Total Retenido" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_view_withholding_islr_report" model="ir.actions.act_window">
            <field name="name">Reporte de Retenciones de ISLR</field>
            <field name="res_model">account.withholding.report</field>
            <field name="view_mode">form</field>
            <field name="context" eval="{'default_tax_type': 'islr'}"/>
        </record>

        <record id="action_view_withholding_iva_report" model="ir.actions.act_window">
            <field name="name">Reporte de Retenciones de IVA</field>
            <field name="res_model">account.withholding.report</field>
            <field name="view_mode">form</field>
            <field name="context" eval="{'default_tax_type': 'iva'}"/>
        </record>

         <!-- <record id="action_view_withholding_iva_report" model="ir.actions.act_window">
            <field name="name">Reporte de Retenciones de IVA</field>
            <field name="res_model">account.withholding.report</field>
            <field name="view_mode">form</field>
            <field name="context" eval="{'default_tax_type': 'iva'}"/>
        </record> -->

        <menuitem
            id="l10n_ve_payment_extension.xml_retention_islr"
            name="Reporte de Retenciones de ISLR"
            parent="l10n_ve_payment_extension.seniat_reports"
            action="action_view_withholding_islr_report"
            sequence="9"
        />

        <menuitem
            id="l10n_ve_payment_extension.txt_retention_iva"
            name="Reporte de Retenciones de IVA"
            parent="l10n_ve_payment_extension.seniat_reports"
            action="action_view_withholding_iva_report"
            sequence="9"
        />
    </data>
</odoo>